# SautiYetu Environment Configuration
# Copy this file to .env and fill in your API keys

# DeepSeek API key — enables AI-powered budget simplification
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional: OpenAI API key (fallback if DeepSeek is not configured)
# OPENAI_API_KEY=

# Optional: Local Ollama host (fallback if no cloud API is available)
# OLLAMA_HOST=http://localhost:11434
