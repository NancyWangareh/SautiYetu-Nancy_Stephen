# ── SautiYetu backend environment (production) ──
# Copy this to src/backend/.env on the VPS and fill in real values.

# ── DeepSeek / LLM ──
DEEPSEEK_API_KEY=sk-REPLACE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Database (absolute Linux path; note the 4 slashes) ──
DATABASE_URL=sqlite+aiosqlite:////home/deploy/sautiyetu/data/sautiyetu.db

# ── Embedding (4 GB RAM — full e5-small model) ──
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# ── Qdrant (local embedded storage) ──
QDRANT_PATH=/home/deploy/sautiyetu/data/qdrant_storage

# ── CORS (only needed if frontend is served from a different origin) ──
CORS_ORIGINS=["https://sautiyetu.example.com"]

# ── PDF upload limit ──
MAX_PDF_SIZE_MB=50
