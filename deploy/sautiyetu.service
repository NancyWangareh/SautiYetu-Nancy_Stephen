[Unit]
Description=SautiYetu FastAPI backend
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/sautiyetu/src/backend
EnvironmentFile=/home/deploy/sautiyetu/src/backend/.env
ExecStart=/home/deploy/sautiyetu/src/backend/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
